{
  "name": "academic-system",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "api",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace api",
    "dev:web": "npm run dev --workspace frontend",
    "build": "npm run build --workspaces --if-present",
    "start:api": "npm run start:prod --workspace api",
    "seed": "npm run seed --workspace api",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true,
    "better-sqlite3@12.11.1": true,
    "@nestjs/core@10.4.22": true
  }
}
