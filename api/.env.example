PORT=3001
DATABASE_PATH=data/app.sqlite
NODE_ENV=development

# JWT
JWT_SECRET=dev-only-secret
JWT_EXPIRES_IN=1d

# bcrypt cost factor used for hashing passwords
BCRYPT_SALT_ROUNDS=12

# Database seeding on application bootstrap (see src/seed/seeder.service.ts).
# Empty tables are populated with the baseline data in src/seed/seed-data.ts.
# Runs by default outside production; set to "false" to disable, or "true"
# to force it on in production. Seeding is idempotent (non-empty tables are
# left alone); use `npm run seed:force` to overwrite the seeded rows.
SEED_ON_STARTUP=true

# Development tool: lets the administrator move the server's clock (header
# "Viagem no tempo" in the app) to see what happens when a period ends.
# On outside production by default; set to "false" to disable it anywhere.
# TIME_TRAVEL=true

# The seats are allocated by themselves when the enrollment period ends (a
# timer, plus whenever a student opens their enrollments or the clock moves).
# On by default (off under tests); set to "false" to leave it to the
# Administration's "Alocar vagas" button.
# AUTO_ALLOCATE=true
